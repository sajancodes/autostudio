# AutoStudio Environment Configuration Template

# Google Gemini API Key (Veo & Gemini LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-2.5-flash

# Veo Video Generation Model & Settings
VEO_MODEL=veo-2.0-generate-001
VEO_ASPECT_RATIO=9:16
VEO_DURATION_SECONDS=5

# Cost and Safety Caps (USD)
MAX_COST_USD=5.00
VEO_COST_PER_SECOND=0.20

# Text To Speech Settings
# Options: offline (pyttsx3/tone), gemini
TTS_PROVIDER=offline
GEMINI_TTS_MODEL=gemini-2.5-flash

# YouTube Data API v3 OAuth Settings
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=youtube_token.json

# Local Universal Browser Engine (read-only web research, optional)
# Copy the same BROWSER_ENGINE_API_KEY value the engine uses in its own .env
BROWSER_ENGINE_URL=http://127.0.0.1:8765
BROWSER_ENGINE_API_KEY=your_browser_engine_api_key_here

# Concurrency & Retries
MAX_CONCURRENT_GENERATIONS=2
MAX_RETRIES=2
